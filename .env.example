# =============================================================================
# Beinex Employee Leave Management System - Environment Configuration Example
# Copy this file to '.env' and update with your actual database credentials.
# DO NOT commit the actual '.env' file containing real secrets to version control.
# =============================================================================

# Server Settings
PORT=8080
APP_ENV=development

# Database Configuration (PostgreSQL with pgx)
# Option 1: Full Connection String URL
# For Neon PostgreSQL (copy directly from your Neon project dashboard):
DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require&channel_binding=require
# Or for Local PostgreSQL:
# DATABASE_URL=postgres://postgres:your_password_here@localhost:5432/beinex_leave_db?sslmode=disable

# Option 2: Individual Connection Parameters (used only if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_NAME=beinex_leave_db
DB_SSLMODE=disable

# Connection Pool Settings
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
